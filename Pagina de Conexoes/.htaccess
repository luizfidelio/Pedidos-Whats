# ──────────────────────────────────────────────────────────────
#  Net e Cia Tecnologia — Hub Central
#  Prioridade: index.html antes de index.php
# ──────────────────────────────────────────────────────────────

# Ordem de prioridade: HTML primeiro, depois PHP
DirectoryIndex index.html index.php

# Charset padrão
AddDefaultCharset UTF-8

# ── Passa o header Authorization para o PHP (necessário p/ JWT) ──
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

# ── Garante que PHP receba o Authorization mesmo no OLS/LiteSpeed ──
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Cache de assets estáticos (1 semana)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png             "access plus 1 week"
    ExpiresByType image/jpeg            "access plus 1 week"
    ExpiresByType image/gif             "access plus 1 week"
    ExpiresByType text/css              "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
</IfModule>
