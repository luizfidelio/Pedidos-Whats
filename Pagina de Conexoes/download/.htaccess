Options -Indexes
DirectoryIndex index.html

# Bloqueia acesso direto a arquivos PHP, HTAccess e HTML avulsos
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
